      <aliases enabled='yes' />
      <column caption='Age_Bracket' datatype='string' name='[Audience - Split 1]' role='dimension' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.0yukr4f1uogq7u1gm3dli116dty5].[Audience]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [Audience], &quot; &quot;, 1 ) )' />
      </column>
      <column caption='Age_Bins' datatype='string' name='[Audience - Split 2]' role='dimension' type='nominal' user:SplitFieldIndex='2' user:SplitFieldOrigin='[federated.0yukr4f1uogq7u1gm3dli116dty5].[Audience]'>
