      </column>
      <column caption='Audience1' datatype='string' name='[Audience]' role='dimension' type='nominal' />
      <column caption='Total Sales Cal' datatype='real' name='[Calculation_0094027492573184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [CampaignType] = &apos;Sign Up&apos; THEN 0 &#13;&#10;ELSE [Total Sales] END' />
      </column>
      <column caption='Cost Per Parameter' datatype='real' name='[Calculation_0094027509682178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE &#13;&#10;[Parameters].[Parameter 1] &#13;&#10;WHEN &apos;Click&apos; THEN [Calculation_1111622593421316]&#13;&#10;WHEN &apos;Conversion&apos; THEN [Calculation_1111622580576257]&#13;&#10;WHEN &apos;Like&apos; THEN [Calculation_1111622592798723]&#13;&#10;WHEN &apos;View&apos; THEN [Calculation_1111622592704514]&#13;&#10;END' />
      </column>
      <column caption='Parameter Display' datatype='string' name='[Calculation_0094027511169027]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE &#13;&#10;[Parameters].[Parameter 1] &#13;&#10;WHEN &apos;Clicks&apos; THEN &apos;Click&apos;&#13;&#10;WHEN &apos;Conversions&apos; THEN &apos;Conversion&apos;&#13;&#10;WHEN &apos;Likes&apos; THEN &apos;Like&apos;&#13;&#10;WHEN &apos;Views&apos; THEN &apos;Views&apos;&#13;&#10;END' />
      </column>
      <column caption='Duration' datatype='integer' name='[Calculation_1111622575030272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Start Date],[End Date])' />
      </column>
      <column caption='CPC Conversion Cost' datatype='real' name='[Calculation_1111622580576257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Expense]) / sum([Conversions])' />
      </column>
      <column caption='CPV View Cost' datatype='real' name='[Calculation_1111622592704514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Expense])/SUM([Views])' />
      </column>
      <column caption='CPL Like Cost' datatype='real' name='[Calculation_1111622592798723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Expense])/SUM([Likes])' />
      </column>
      <column caption='CPC Click Cost' datatype='real' name='[Calculation_1111622593421316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Expense])/SUM([Clicks])' />
      </column>
      <column caption='Campaign Type' datatype='string' name='[CampaignType]' role='dimension' type='nominal' />
      <column caption='Channel1' datatype='string' name='[Channel]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Clicks]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Conversions]' role='measure' type='quantitative' />
      <column datatype='real' name='[Expense]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Likes]' role='measure' type='quantitative' />
      <column caption='label Total Sales' datatype='string' name='[Total Sales Cal (copy)_2424443046801408]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Total Sales]) = 0 THEN &apos;&apos;&#13;&#10;ELSE&#13;&#10;    &quot;$&quot; + STR(ROUND(SUM([Total Sales]) / 1000000, 2)) + &quot;M&quot;&#13;&#10;END' />
      </column>
      <column datatype='real' name='[Total Sales]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Views]' role='measure' type='quantitative' />
      <column caption='Sheet1' datatype='table' name='[__tableau_internal_object_id__].[Sheet1_B5A5A42679DF4E78902293699877B212]' role='measure' type='quantitative' />
      <column-instance column='[Clicks]' derivation='Sum' name='[pcto:sum:Clicks:qk]' pivot='key' type='quantitative'>
        <table-calc ordering-type='Rows' type='PctTotal' />
      </column-instance>
      <column-instance column='[Views]' derivation='Sum' name='[pcto:sum:Views:qk]' pivot='key' type='quantitative'>
